# ── Fortran build artifacts ──────────────────────────────────────────────────
*.o
*.mod
mods/*
!mods/.gitkeep
objects/*
!objects/.gitkeep
profiling/
lib/dummy.txt

# ── Compiled binaries / libraries ────────────────────────────────────────────
*.exe
*.so
*.a
*.lib
*.dll
*.dylib
*.framework
/classyMC
/classyMC_debug
/test_delta_energy
/test_neighborlist

# ── Simulation output files (keep only inputs in the repo) ────────────────────
# Run logs / screen capture
*.log
log.lammps
**/ScreenOutput_*.txt
**/output.txt
**/output2.txt

# Analysis / umbrella / energy data written by runs
*.dat
*.xyz
*.dump
*.lammpstrj
*.xsf
*.png

# Runtime-written restart / output coordinates (numbered Config_N_M.clssy)
**/Config_[0-9]*.clssy
**/Out_[0-9]*.clssy

# Generic txt leftovers from runs (allow README/docs exceptions below)
Example/**/*.txt
lib/dummy.txt
mods/dummy.txt
objects/dummy.txt
docs/TodoList.txt

# ── Python cache ──────────────────────────────────────────────────────────────
*.pyc
__pycache__/

# ── Sphinx documentation build ────────────────────────────────────────────────
docs/_build/
docs/auto/

# ── Editor temp / swap files ─────────────────────────────────────────────────
*.swp
*.swo
*~
.DS_Store

# ── Backup / temp leftovers in examples ───────────────────────────────────────
**/*_backup.clssy
**/*_backup.clFF
**/*_backup.clff
**/fort.*
**/tmp_in.*
Example/AENet/...
