# TIP4P Water Model with Ewald Electrostatics
# Standard TIP4P parameters for comparison with LAMMPS
# Reference: Jorgensen et al., Mol. Phys. 56, 1381 (1985)
#
# TIP4P Parameters:
#   O-H bond length: 0.9572 Å
#   H-O-H angle: 104.52°
#   epsilon_O = 0.1550 kcal/mol = 78.0 kb
#   sigma_O = 3.1536 Å
#   q_O = 0.0 e (charge on virtual site M)
#   q_H = +0.52 e
#   q_M = -1.04 e
#   O-M distance = 0.15 Å

moleculetypes 1

atomdef
#  Element - Atomic Mass
  "O"  15.9994
  "H"  1.008
  "M"  0.0
end_atomdef

bonddef
  ridgid 0.9572 
  ridgid 0.15
end_bonddef

units angle deg

AngleDef
  ridgid 104.52
  ridgid 52.26
End_AngleDef

molecule 1
  RegrowthType Ridgid "TIP4P.xyz"

  atoms
    1
    2
    2
    3
  end_atoms

  bonds
    1   1 2
    1   1 3
    2   1 4
  end_bonds

  angles
    1    2 1 3
    2    2 1 4
    2    3 1 4
  end_angles
end_molecule

forcefieldtype
  hybrid
  EP_LJ_Cut
  ewald
end_forcefieldtype

units energy kb

# Hybrid LJ + Ewald parameters
forcefield 1
  nfields 2
  forcefields 2 3
end_forcefield

# Lennard-Jones
# type epsilon(kb) sigma(Å) rmin(Å)
forcefield 2
  rcut 9.0
  1  78.0    3.1536       1.0
  2  0.0     0.0          0.5
  3  0.0     0.0          0.2
end_forcefield

# Ewald electrostatics
# type charge(e) rmin(Å)
forcefield 3
  rcut 9.0
  alpha 0.3
  kmax 5.0
  1   0.0   1.0
  2   0.52  0.5
  3  -1.04  0.2
end_forcefield

