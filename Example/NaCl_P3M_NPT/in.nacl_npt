#======================================
# NaCl NPT Monte Carlo with P3M
#======================================
  set rng_seed -6
  set NeighSkin 2.0
  set moves 10
  set cycles 1000
  SamplingType Metropolis

  ForceField "NaCl_P3M_NPT.clFF"

  Create Boxes
    fromfile "NaCl_Config.clssy"
  End_Create

  modify box 1 energycalc 1
  modify box 1 temperature 300
  modify box 1 pressure 1.0
  modify box 1 buildfreq 100

  NeighList 1 cellrsqlist 1

  Create Moves
    AtomTranslation 900.0
    IsoVol 100.0
  End_Create

  modify move 1 maxdisplace 0.1

  Run
#=====================================

