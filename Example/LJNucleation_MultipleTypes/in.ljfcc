#======================================
# Example Script capable of computing the nucleation free energy
# of a Lennard-Jones system using the AVBMC or UB approach. 
#======================================
#
  set rng_seed -6
  set NeighSkin 6.0
  set moves 10
  set cycles 600000
  SamplingType UmbrellaWHAM
  modify Sampling biasvariables 3
  modify Sampling analysis 1 1
  modify Sampling analysis 2 2
  modify Sampling analysis 3 3
  modify Sampling bounds 1 5 0.0 5.0
  modify Sampling bounds 2 5 0.0 5.0
  modify Sampling bounds 3 5 0.0 5.0
  modify Sampling reference 1.0 0.0 0.0 0.0 
  modify Sampling whamfreq 100000

  ForceField "LJForcefield.clFF"

  Create Boxes
    fromfile "Dimer.clssy"
  End_Create

  modify box 1 energycalc 1
  modify box 1 temperature 0.8
  modify box 1 buildfreq 100

  # To account for the ordering entropy we need to take the single component mu and
  # modify it by ln(n) where n is the number of speices. Single mu = -9.210340372
  modify box 1 chempotential 1 -8.111728083331
  modify box 1 chempotential 2 -8.111728083331
  modify box 1 chempotential 3 -8.111728083331
  NeighList 1 rsqlist 1
  modify box 1 neighlist 1 rcut 46.5
  

  Create Moves
    AtomTranslation 2.0
#    UBSwap 1.0
    AVBMC 1.0
  End_Create

  modify move 2 radius 1.5

  Create constraint 1
    #distancecriteria 1 1.5 1
     allmoldistancecriteria 1 1.5 1 1.5 1 1.5  
  End_Create

  Create Analysis
    clustersize 1 1 
    clustersize 1 2
    clustersize 1 3 
  End_Create


 Create trajectory
   dump 1 1 "Traj.dump"
 End_Create


  Run
#=====================================
