#======================================
# Copper Monte Carlo with EAM Potential
#======================================
  set rng_seed -6
  set NeighSkin 2.0
  set moves 100
  set cycles 2000
  SamplingType Metropolis

  ForceField "Cu_EAM.clFF"

  Create Boxes
    fromfile "Cu_FCC.clssy"
  End_Create

  modify box 1 energycalc 1
  modify box 1 temperature 100
  modify box 1 buildfreq 100

  NeighList 1 cellrsqlist 1

  Create Moves
    AtomTranslation 1000.0
  End_Create

  modify move 1 maxdisplace 0.05

  Run
#=====================================
