# NaCl Forcefield - Ewald Coulomb Only
# Pure electrostatics using Ewald summation
# For energy comparison with FMM

moleculetypes 2

atomdef
#  Element - Atomic Mass
  "Na"  22.99
  "Cl"  35.45
end_atomdef

# Na+ molecule (type 1)
molecule 1
  RegrowthType Simple
  atoms
    1
  end_atoms
end_molecule

# Cl- molecule (type 2)
molecule 2
  RegrowthType Simple
  atoms
    2
  end_atoms
end_molecule

forcefieldtype
  ewald
end_forcefieldtype

units energy kb

# Ewald Coulomb parameters
forcefield 1
  rcut 10.0
  alpha 0.25
  kmax 5.0
  charge 1  1.0
  charge 2 -1.0
  rmin 1 1.2
  rmin 2 1.2
end_forcefield
