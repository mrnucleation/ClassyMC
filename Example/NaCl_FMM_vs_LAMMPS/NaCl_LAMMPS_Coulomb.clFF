# NaCl Forcefield - LAMMPS Coulomb Only
# Pure electrostatics using LAMMPS coul/long + PPPM
# For energy comparison with ClassyMC FMM
#
# LAMMPS uses "real" units (kcal/mol, Angstroms)
# energy_conversion converts LAMMPS kcal/mol to ClassyMC kb units
# 1 kcal/mol = 503.228 kb

moleculetypes 2

atomdef
#  Element - Atomic Mass
  "Na"  22.99
  "Cl"  35.45
end_atomdef

# Na+ molecule (type 1)
molecule 1
  RegrowthType Simple
  atoms
    1
  end_atoms
end_molecule

# Cl- molecule (type 2)
molecule 2
  RegrowthType Simple
  atoms
    2
  end_atoms
end_molecule

forcefieldtype
  lammps
end_forcefieldtype

units energy kb

# LAMMPS Coulomb parameters
forcefield 1
  rcut 10.0

  # LAMMPS setup commands (executed before atoms are created)
  lammps_cmd atom_style charge
  lammps_cmd create_box 2 box
  lammps_cmd mass 1 22.99
  lammps_cmd mass 2 35.45
  lammps_cmd pair_style coul/long 10.0
  lammps_cmd pair_coeff * *
  lammps_cmd kspace_style pppm 1.0e-6

  # Post-creation commands (executed after atoms exist in LAMMPS)
  # These set the charges on each atom type
  lammps_postcmd set type 1 charge  1.0
  lammps_postcmd set type 2 charge -1.0

  # Convert LAMMPS energy (kcal/mol) to ClassyMC energy (kb)
  # lammps_get_thermo("pe") returns per-atom PE (norm=yes default in real units)
  # GetEnergy multiplies by n_atoms to get total, then by this factor
  energy_conversion 503.228

  # Length conversion (both use Angstroms)
  length_conversion 1.0

  # Minimum distances for overlap checking
  1  1.2
  2  1.2

end_forcefield
