#=========================================================
# Forcefield file for TraPPE-UA Isobutane (2-methylpropane)
# 
# Isobutane structure (branched):
#
#        CH3(2)
#         |
#  CH3(1)-CH(4)-CH3(3)
#
# This tests the BranchCBMC regrowth algorithm for 
# molecules with a central branch point.
#=========================================================

moleculetypes 1

atomdef
#  Element - Atomic Mass
 "CH3" 15.035       # Methyl group  
 "CH"  13.019       # Tertiary CH (branch point)
end_atomdef

units energy kb
units angle deg

bonddef
  ridgid  1.5400    # Alkane CHx-CHx bond
end_bonddef

AngleDef
  harmonic 112.0 62500  # CHx-CH-CHx angle at branch point
End_AngleDef

# No torsions needed - all atoms share central carbon as common vertex

molecule 1
  # Use BranchCBMC for branched molecule regrowth
  RegrowthType BranchCBMC 5
  
  atoms
      1    # CH3 - methyl 1
      1    # CH3 - methyl 2  
      1    # CH3 - methyl 3
      2    # CH  - central branch point (tertiary carbon)
  end_atoms

  # Bonds connect each methyl to the central carbon
  bonds
   1   1 4    # CH3(1) - CH(4)
   1   2 4    # CH3(2) - CH(4)
   1   3 4    # CH3(3) - CH(4)
  end_bonds

  # Angles between methyls through central carbon
  angles
     1   1 4 2  # CH3(1)-CH(4)-CH3(2)
     1   1 4 3  # CH3(1)-CH(4)-CH3(3)
     1   2 4 3  # CH3(2)-CH(4)-CH3(3)
  end_angles

  # No torsions - no 4-atom chains exist
     
end_molecule

forcefieldtype
  EP_LJ_Cut
end_forcefieldtype

# TraPPE-UA Lennard-Jones parameters
# type epsilon(K) sigma(A) rmin
forcefield 1
  rcut 12.0
  tailcorrection .true.
  # CH3 (methyl): eps=98K, sig=3.75A
  1  98.00  3.7500   1.1
  # CH (tertiary): eps=10K, sig=4.68A  
  2  10.00  4.6800   1.1
end_forcefield
