# TIP3P Water Model with P3M Electrostatics
# Uses two forcefields: LJ for dispersion, P3M for electrostatics
#

moleculetypes 1

atomdef
#  Element - Atomic Mass
  "O"  15.9994
  "H"  1.008
end_atomdef

bonddef
  ridgid 0.9572 
end_bonddef

units angle deg

AngleDef
  ridgid 104.52
End_AngleDef

molecule 1
  RegrowthType Simple

  atoms
    1
    2
    2
  end_atoms

  bonds
    1   1 2
    1   1 3
  end_bonds

  angles
    1    2 1 3
  end_angles
end_molecule

# Two forcefields: LJ for dispersion, P3M for electrostatics
forcefieldtype
  ep_lj_cut
  p3m
end_forcefieldtype

units energy kb

# Forcefield 1: LJ interactions (on oxygen only)
# type epsilon(kb) sigma(Å) rmin(Å)
forcefield 1
  rcut 6.0
  1  51.3284  3.188   1.0
  2  0.0      0.0      0.5
end_forcefield

# Forcefield 2: P3M electrostatics
# type charge(e) rmin(Å)
forcefield 2
  rcut 6.0
  alpha 0.35
  mesh 32 32 32
  order 3
  precision 1.0E-4
  1  -0.830  1.0
  2   0.415  0.5
end_forcefield
