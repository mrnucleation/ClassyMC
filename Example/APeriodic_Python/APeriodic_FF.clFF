moleculetypes 2

atomdef
#  Element - Atomic Mass
  "He"  4.002602
  "Ar"  39.948
  "Ne"  20.180
  "O"  16.00
end_atomdef

molecule 1
  RegrowthType Simple
  atoms
    1
  end_atoms
end_molecule

molecule 2
  RegrowthType Simple
  atoms
    2
  end_atoms
end_molecule

molecule 3
  RegrowthType Simple
  atoms
    3
  end_atoms
end_molecule

molecule 4
  RegrowthType Simple
  atoms
    4
  end_atoms
end_molecule

# Use Python-defined energy function for two-component LJ system
forcefieldtype
  pythonenergy
end_forcefieldtype

# Configure the Python energy module
forcefield 1
  module two_component_lj
  rcut 6.0
end_forcefield
