# NaCl Forcefield using LJ + Ewald Electrostatics
# Uses the LJ + Ewald combined forcefield for efficient 
# Monte Carlo simulations of ionic systems

moleculetypes 2

atomdef
#  Element - Atomic Mass
  "Na"  22.99
  "Cl"  35.45
end_atomdef

# Na+ molecule (type 1)
molecule 1
  RegrowthType Simple
  atoms
    1
  end_atoms
end_molecule

# Cl- molecule (type 2)
molecule 2
  RegrowthType Simple
  atoms
    2
  end_atoms
end_molecule

forcefieldtype
  hybrid
  EP_LJ_Cut
  ewald
end_forcefieldtype

units energy kb

# Na-Cl system using hybrid LJ + Ewald
forcefield 1
  nfields 2
  forcefields 2 3
end_forcefield

# Lennard-Jones
# type epsilon sigma rmin
forcefield 2
  rcut 4.5
  1  23.60105  2.58478  0.5
  2  75.48309  4.4      0.5
end_forcefield

# Ewald electrostatics
# type charge rmin
forcefield 3
  rcut 7.0
  alpha 0.25
  kmax 5.0
  1   1.0  0.5
  2  -1.0  0.5
end_forcefield

