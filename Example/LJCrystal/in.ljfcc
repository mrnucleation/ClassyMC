#======================================
  set rng_seed 6
  set NeighSkin 6.0
  set moves 1000
  set cycles 10000
  SamplingType Metropolis

  ForceField "LJForcefield.clFF"

  Create Boxes
    Preset FCC 1.58740105197 4
  End_Create

  modify box 1 energycalc 1
  modify box 1 temperature 0.7
  modify box 1 buildfreq 500

  NeighList 1 cellrsqlist 1

  Create Moves
    AtomTranslation 256.0
    IsoVol 1.0
  End_Create

  Create trajectory
    xyz 1 100 "Traj.xyz"
  End_Create

  Run
#=====================================
