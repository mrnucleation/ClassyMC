# TIP3P Water Model - LAMMPS lj/cut/coul/long + PPPM
# Uses LAMMPS library for LJ + long-range Coulomb via PPPM
# For energy comparison with ClassyMC FMM and Ewald
#
# LAMMPS uses "real" units (kcal/mol, Angstroms)
# energy_conversion converts LAMMPS kcal/mol to ClassyMC kb units
# 1 kcal/mol = 503.228 kb
#
# TIP3P Parameters in kcal/mol:
#   epsilon_O = 0.1521 kcal/mol (= 76.54 kb)
#   sigma_O = 3.1507 Å
#   q_O = -0.834 e
#   q_H = +0.417 e

moleculetypes 1

atomdef
#  Element - Atomic Mass
  "O"  15.9994
  "H"  1.008
end_atomdef

bonddef
  ridgid 0.9572
end_bonddef

units angle deg

AngleDef
  ridgid 104.52
End_AngleDef

molecule 1
  RegrowthType Simple

  atoms
    1
    2
    2
  end_atoms

  bonds
    1   1 2
    1   1 3
  end_bonds

  angles
    1    2 1 3
  end_angles
end_molecule

forcefieldtype
  lammps
end_forcefieldtype

units energy kb

# LAMMPS parameters for TIP3P water
forcefield 1
  rcut 9.0

  # LAMMPS setup commands (executed before atoms are created)
  lammps_cmd atom_style charge
  lammps_cmd create_box 2 box
  lammps_cmd mass 1 15.9994
  lammps_cmd mass 2 1.008
  lammps_cmd pair_style lj/cut/coul/long 9.0 9.0
  lammps_cmd pair_coeff 1 1 0.1521 3.1507
  lammps_cmd pair_coeff 1 2 0.0 0.0
  lammps_cmd pair_coeff 2 2 0.0 0.0
  lammps_cmd kspace_style pppm 1.0e-6
  # PPPM uses tin-foil BC by default (matches ClassyMC's new default).

  # Post-creation commands (executed after atoms exist in LAMMPS)
  lammps_postcmd set type 1 charge -0.834
  lammps_postcmd set type 2 charge  0.417

  # When exclude_intramol is on, ClassyMC subtracts the full direct-sum
  # intramolecular Coulomb energy (all same-molecule 1-2 / 1-3 pairs,
  # BOTH real-space AND kspace PPPM contributions) from LAMMPS's total.
  # The result is the same "intermolecular only" energy that ClassyMC's
  # Ewald and FMM produce, so the three codes are directly comparable.
  exclude_intramol true

  # Convert LAMMPS energy (kcal/mol) to ClassyMC energy (kb)
  energy_conversion 503.228

  # Length conversion (both use Angstroms)
  length_conversion 1.0

  # Minimum distances for overlap checking
  1  1.0
  2  0.5

end_forcefield
