# TIP3P Water Model - Hybrid LJ + Ewald Forcefield
# Uses a hybrid forcefield that combines:
#   - 12-6 Lennard-Jones for short-range dispersion
#   - Ewald summation for long-range electrostatics
# For energy comparison with FMM and LAMMPS
#
# TIP3P Parameters (Jorgensen et al., J. Chem. Phys. 79, 926 (1983)):
#   epsilon_O = 76.54 kb (0.1521 kcal/mol)
#   sigma_O = 3.1507 Å
#   q_O = -0.834 e
#   q_H = +0.417 e

moleculetypes 1

atomdef
#  Element - Atomic Mass
  "O"  15.9994
  "H"  1.008
end_atomdef

bonddef
  ridgid 0.9572
end_bonddef

units angle deg

AngleDef
  ridgid 104.52
End_AngleDef

molecule 1
  RegrowthType Simple

  atoms
    1
    2
    2
  end_atoms

  bonds
    1   1 2
    1   1 3
  end_bonds

  angles
    1    2 1 3
  end_angles
end_molecule

forcefieldtype
  hybrid
  EP_LJ_Cut
  ewald
end_forcefieldtype

units energy kb

# Hybrid LJ + Ewald parameters
# Cutoffs match LAMMPS comparison (9.0 Å for both LJ and Coulomb real-space)
forcefield 1
  nfields 2
  forcefields 2 3
end_forcefield

# Forcefield 2: Lennard-Jones
# type  epsilon(kb)  sigma(Å)  rmin(Å)
forcefield 2
  rcut 9.0
  tailcorrection .false.
  1  76.54   3.1507  1.0
  2   0.0    0.0     0.5
end_forcefield

# Forcefield 3: Ewald electrostatics
forcefield 3
  rcut 9.0
  # Well-converged Ewald parameters for a 25 A box:
  #   alpha * rcut > 3 -> real-space truncation error << 1e-4
  #   kmax = 8 gives reciprocal-space truncation at same precision.
  alpha 0.40
  kmax 8.0
  # Tin-foil (conducting) BC: drops the surface dipole term. This is the
  # default and matches LAMMPS PPPM, so the two energies are directly comparable.
  surface tinfoil
  # type  charge(e)  rmin(Å)
  1 -0.834  1.0
  2  0.417  0.5
end_forcefield
