# TIP3P Water Model - Hybrid FMM Forcefield
# Combines LJ (short-range) with FMM electrostatics (long-range)
# For energy comparison with LAMMPS lj/cut/coul/long + PPPM
#
# TIP3P Parameters (Jorgensen et al., J. Chem. Phys. 79, 926 (1983)):
#   O-H bond length: 0.9572 Å
#   H-O-H angle: 104.52°
#   epsilon_O = 76.54 kb (0.1521 kcal/mol)
#   sigma_O = 3.1507 Å
#   q_O = -0.834 e
#   q_H = +0.417 e

moleculetypes 1

atomdef
#  Element - Atomic Mass
  "O"  15.9994
  "H"  1.008
end_atomdef

bonddef
  ridgid 0.9572
end_bonddef

units angle deg

AngleDef
  ridgid 104.52
End_AngleDef

molecule 1
  RegrowthType Simple

  atoms
    1
    2
    2
  end_atoms

  bonds
    1   1 2
    1   1 3
  end_bonds

  angles
    1    2 1 3
  end_angles
end_molecule

# Hybrid forcefield: EP_LJ_Cut for dispersion, FMM for electrostatics
forcefieldtype
  hybrid
  EP_LJ_Cut
  fmm
end_forcefieldtype

units energy kb

# Forcefield 1: Hybrid combining LJ (ff2) and FMM (ff3)
forcefield 1
  nfields 2
  forcefields 2 3
end_forcefield

# Forcefield 2: Lennard-Jones (oxygen only, hydrogen has no LJ)
# rcut matches LAMMPS lj/cut/coul/long cutoff for consistent comparison
# type  epsilon(kb)  sigma(Å)  rmin(Å)
forcefield 2
  rcut 9.0
  tailcorrection .true.
  1  76.54   3.1507   1.0
  2   0.0    0.0      0.5
end_forcefield

# Forcefield 3: FMM long-range electrostatics
# Parameters match LAMMPS comparison: rcut=9.0 for consistent near-field treatment
# type  charge(e)  rmin(Å)
forcefield 3
  usemultipole true
  order 6
  maxlevel 4
  ncrit 10
  rcut 9.0
  periodic true
  charge 1 -0.834
  charge 2  0.417
  rmin 1 1.0
  rmin 2 0.5
end_forcefield
