# TIP3P Water Model with FMM Electrostatics
# Uses two forcefields: LJ for dispersion, FMM for electrostatics
#

moleculetypes 1

atomdef
#  Element - Atomic Mass
  "O"  15.9994
  "H"  1.008
end_atomdef

bonddef
  ridgid 0.9572 
end_bonddef

units angle deg

AngleDef
  ridgid 104.52
End_AngleDef

molecule 1
  RegrowthType Simple

  atoms
    1
    2
    2
  end_atoms

  bonds
    1   1 2
    1   1 3
  end_bonds

  angles
    1    2 1 3
  end_angles
end_molecule

# Two forcefields: LJ for dispersion, FMM for electrostatics
forcefieldtype
 hybrid
  ep_lj_cut
  fmm
end_forcefieldtype

units energy kb

# Forcefield 3: Hybrid combining LJ and FMM
forcefield 1
  nfields 2
  forcefields 2 3
end_forcefield



# Forcefield 1: LJ interactions (on oxygen only)
# type epsilon(kb) sigma(Å) rmin(Å)
forcefield 2
  rcut 5.0
  tailcorrection .true.
  1  76.525  3.15066  0.8
  2  0.0       0.0      0.5
end_forcefield

# Forcefield 2: FMM electrostatics
# type charge(e) rmin(Å)
forcefield 3
  order 6
  maxlevel 5
  ncrit 10
  rcut 5.0
  periodic true
  charge 1  -0.834
  charge 2   0.417
  rmin 1 0.0
  rmin 2 0.0
end_forcefield
