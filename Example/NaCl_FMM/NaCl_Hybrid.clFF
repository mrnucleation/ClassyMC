# NaCl Forcefield using Hybrid (LJ + FMM)
# Combines Lennard-Jones for short-range interactions
# with Fast Multipole Method for electrostatics
#

moleculetypes 2

atomdef
#  Element - Atomic Mass
  "Na"  22.99
  "Cl"  35.45
end_atomdef

# Na+ molecule (type 1)
molecule 1
  RegrowthType Simple
  atoms
    1
  end_atoms
end_molecule

# Cl- molecule (type 2)
molecule 2
  RegrowthType Simple
  atoms
    2
  end_atoms
end_molecule

forcefieldtype
  hybrid
  EP_LJ_Cut
  fmm
end_forcefieldtype

units energy kb

# Forcefield 3: Hybrid combining LJ and FMM
forcefield 1
  nfields 2
  forcefields 2 3
end_forcefield

#Forcefield 1: Lennard-Jones (short-range van der Waals)
# Format: type epsilon sigma rmin
forcefield 2
  rCut 4.0
  tailcorrection .false.
  # Na: ε/kB = 17.44 K, σ = 2.52 Å
  1  23.60105  2.58478  0.5
  # Cl: ε/kB = 192.45 K, σ = 3.85 Å
  2  75.48309  4.4 0.5
end_forcefield

# Forcefield 2: FMM (long-range electrostatics)
forcefield 3
  usemultipole true
  # Multipole expansion order (higher = more accurate, slower)
  order 4
  # Maximum octree depth
  maxlevel 4
  # Particles per leaf cell
  ncrit 10
  # Near-field cutoff
  rcut 7.0
  # Enable periodic boundaries
  periodic true
  # Charge assignments with λ = 0.885 scaling
  charge 1 1.0
  charge 2 -1.0
  rmin 1 1.2
  rmin 2 1.2
end_forcefield

