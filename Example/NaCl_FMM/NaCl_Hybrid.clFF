# NaCl Forcefield using Hybrid (LJ + FMM)
# Combines Lennard-Jones for short-range interactions
# with Fast Multipole Method for electrostatics
#

moleculetypes 2

atomdef
#  Element - Atomic Mass
  "Na"  22.99
  "Cl"  35.45
end_atomdef

# Na+ molecule (type 1)
molecule 1
  RegrowthType Simple
  atoms
    1
  end_atoms
end_molecule

# Cl- molecule (type 2)
molecule 2
  RegrowthType Simple
  atoms
    2
  end_atoms
end_molecule

forcefieldtype
  hybrid
  EP_LJ_Cut
  fmm
end_forcefieldtype


# Forcefield 3: Hybrid combining LJ and FMM
forcefield 1
  nfields 2
  forcefields 2 3
end_forcefield

#Forcefield 1: Lennard-Jones (short-range van der Waals)
forcefield 2
  rCut 7.0
  tailcorrection .true.
  1  17.44  2.52 1.8
  2  192.45  3.85 2.0
end_forcefield

# Forcefield 2: FMM (long-range electrostatics)
forcefield 3
  usemultipole true
  order 5
  maxlevel 6
  ncrit 6
  rcut 7.0
  periodic true
  charge 1 1.0
  charge 2 -1.0
  rmin 1 0.5
  rmin 2 0.5
end_forcefield

