# NaCl Forcefield using Hybrid (LJ + FMM)
# Combines Lennard-Jones for short-range interactions
# with Fast Multipole Method for electrostatics
#

moleculetypes 2

atomdef
#  Element - Atomic Mass
  "Na"  22.99
  "Cl"  35.45
end_atomdef

# Na+ molecule (type 1)
molecule 1
  RegrowthType Simple
  atoms
    1
  end_atoms
end_molecule

# Cl- molecule (type 2)
molecule 2
  RegrowthType Simple
  atoms
    2
  end_atoms
end_molecule

forcefieldtype
  hybrid
  #EP_LJ_Cut
  tosifumi
  fmm
end_forcefieldtype


# Forcefield 3: Hybrid combining LJ and FMM
forcefield 1
  nfields 2
  forcefields 2 3
end_forcefield

units energy ev
#Forcefield 1: Lennard-Jones (short-range van der Waals)
forcefield 2
  rCut 10.0
  tailcorrection .true.
  rmin 1 1 1.5
  rmin 1 2 1.5
  rmin 2 2 1.5

  pair   1 1    487.0 0.23768  1.05   0.50 #Na-Na
  pair   1 2 145134.0 0.23768  6.99   8.70 #Na-Cl
  pair   2 2 405774.0 0.23768  72.40 145.40 #Cl-Cl
end_forcefield

# Forcefield 2: FMM (long-range electrostatics)
forcefield 3
  usemultipole true
  # Multipole expansion order (higher = more accurate, slower)
  order 4
  # Maximum octree depth
  maxlevel 4
  # Particles per leaf cell
  ncrit 5
  # Near-field cutoff
  rcut 10.0
  # Enable periodic boundaries
  periodic true
  # Charge assignments with λ = 0.885 scaling
  charge 1 1.0
  charge 2 -1.0
  rmin 1 1.2
  rmin 2 1.2
end_forcefield

