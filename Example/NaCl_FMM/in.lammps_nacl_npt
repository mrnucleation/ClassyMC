# Basic LAMMPS input for NaCl with Tosi-Fumi BMH potential

units           metal
atom_style      charge
dimension       3
boundary        p p p

# ---------- Variables ----------
variable a equal 3.64        # lattice constant (Angstroms, NaCl ~5.64 Å)
variable nx equal 5
variable ny equal 5
variable nz equal 5

# ---------- Lattice ----------
#lattice custom ${a} &
#        a1 1 0 0 &
#        a2 0 1 0 &
#        a3 0 0 1 &
#        basis 0.0 0.0 0.0 &
#        basis 0.5 0.5 0.5

region box block 0 ${nx} 0 ${ny} 0 ${nz}
create_box 2 box

# type 1 = Na, type 2 = Cl
create_atoms 1 box basis 1 1 basis 2 2


# Masses (atomic mass units)
mass            1 22.990   # Na
mass            2 35.453   # Cl

# Charges
group           na type 1
group           cl type 2
set             group na charge +1.0
set             group cl charge -1.0
#
write_data init.data

# ---------- Born + Coulomb (full A,rho,C,D) ----------
pair_style   born/coul/long 10.0 10.0    # A, rho, sigma=0, C, D
pair_coeff   * *      0.0 1.000   0.00  0.00   0.00
pair_coeff   1 1    487.0 0.23768 0.00  1.05   0.50 #Na-Na
pair_coeff   1 2 145134.0 0.23768 0.00  6.99   8.70 #Na-Cl
pair_coeff   2 2 405774.0 0.23768 0.00 72.40 145.40 #Cl-Cl


# K-space for long-range Coulomb
kspace_style    pppm 1.0e-5

# Neighbor list settings
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

# Energy minimization
minimize        1.0e-8 1.0e-8 100000 1000000
velocity all create 300.0 4928459 rot yes dist gaussian
# Short MD run in NPT ensemble at 300 K and 1 Bar
fix             1 all nvt temp 300.0 300.0 0.01 
timestep        0.001
thermo          100
thermo_style   custom step temp pe etotal press vol density
thermo_modify  norm yes
dump            1 all custom 100 dump.nacl.lammpstrj id type x y z vx vy vz
run             10000


unfix 1


fix             1 all npt temp 300.0 300.0 0.01 iso 1.0 1.0 1.0
run 100000
# End of script
