# LAMMPS input script for TIP3P water density comparison
# Matching ClassyMC TIP3P_Ewald test case

units           real
atom_style      full
boundary        p p p

pair_style      hybrid/overlay lj/cut 6.0 coul/long 7.5
bond_style      harmonic
angle_style     harmonic

read_data       data.lammps

# Pair coefficients
# Type 1: O, Type 2: H
pair_coeff      1 1 lj/cut 0.1521 3.1507
pair_coeff      1 2 lj/cut 0.0    0.0
pair_coeff      2 2 lj/cut 0.0    0.0

pair_coeff      * * coul/long

pair_modify     tail yes

# Bond and angle coeffs (needed for SHAKE, even if rigid)
bond_coeff      1 1000.0 0.9572
angle_coeff     1 1000.0 104.52

kspace_style    pppm 1.0e-6
kspace_modify   gewald 0.3

# Rigid water using SHAKE
fix             1 all shake 0.0001 20 0 b 1 a 1

# NPT ensemble to compare density
# 1.0 bar = 0.986923 atm
fix             2 all npt temp 300.0 300.0 100.0 iso 0.986923 0.986923 1000.0

# Neighbors
neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

# Output
thermo          100
thermo_style    custom step temp press density vol etotal
thermo_modify   flush yes

# Production run
timestep        1.0
run             100000
