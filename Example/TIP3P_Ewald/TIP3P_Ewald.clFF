# TIP3P Water Model with Ewald Electrostatics
# Standard TIP3P parameters for comparison with LAMMPS
# Reference: Jorgensen et al., J. Chem. Phys. 79, 926 (1983)
#
# TIP3P Parameters:
#   O-H bond length: 0.9572 Å
#   H-O-H angle: 104.52°
#   epsilon_O = 0.1521 kcal/mol = 76.54 kb
#   sigma_O = 3.1507 Å
#   q_O = -0.834 e
#   q_H = +0.417 e

moleculetypes 1

atomdef
#  Element - Atomic Mass
  "O"  15.9994
  "H"  1.008
end_atomdef

bonddef
  ridgid 0.9572 
end_bonddef

units angle deg

AngleDef
  ridgid 104.52
End_AngleDef

molecule 1
  RegrowthType Simple

  atoms
    1
    2
    2
  end_atoms

  bonds
    1   1 2
    1   1 3
  end_bonds

  angles
    1    2 1 3
  end_angles
end_molecule

forcefieldtype
  lj_ewald
end_forcefieldtype

units energy kb

# LJ + Ewald parameters
# type epsilon(kb) sigma(Å) charge(e) rmin(Å)
forcefield 1
  ljrcut 9.0
  ewaldrcut 9.0
  alpha 0.3
  kmax 5.0
  1  76.54    3.1507       -0.834   1.0
  2  0.0      0.0           0.417   0.5
end_forcefield

